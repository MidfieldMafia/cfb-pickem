# Every text file is LF, in the index and in the working copy alike. Without
# eol=lf, Git for Windows' installer default (core.autocrlf=true) checks files
# out as CRLF, and every scripted edit trips on it: Git Bash `sed -i` silently
# strips the CRs, a Python or Node replace that matches on "\n" misses, and a
# shell script fails with `$'\r': command not found` -- including
# .claude/hooks/preflight.sh, which runs in every fresh worktree.
* text=auto eol=lf
